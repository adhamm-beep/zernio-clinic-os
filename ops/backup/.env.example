# Supabase database connection string. Use the Session Pooler string and keep it secret.
BACKUP_DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@POOLER_HOST:5432/postgres
BACKUP_PROJECT_REF=smkyqnukliuckemrmndr

# rclone remotes. The destination must be an rclone "crypt" remote layered over S3.
BACKUP_SUPABASE_STORAGE_REMOTE=supabase-storage:
BACKUP_ENCRYPTED_REMOTE=panthera-backup-crypt:

BACKUP_TIMEZONE=Asia/Riyadh
BACKUP_RETENTION_DAYS=30
# Keep disabled until the first restore drill succeeds.
BACKUP_ENABLE_PRUNE=false

# Optional status email. Never include patient data in notification messages.
BACKUP_NOTIFY_EMAIL=adham.m@panthera.sa
BACKUP_FROM_EMAIL=Panthera Security <security@YOUR_VERIFIED_DOMAIN>
RESEND_API_KEY=

# Use a directory on an encrypted local volume.
BACKUP_WORK_DIR=/var/lib/panthera-backup/tmp
