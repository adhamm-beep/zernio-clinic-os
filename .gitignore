# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local analysis and generated review artifacts
/.codex-tmp/
/outputs/
/project-structure.txt
/supabase/.temp/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
**/*firebase-adminsdk*.json
**/firebase-service-account*.json
**/google-service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!mobile-patient/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local audit and generated report working files
.codex-work/
tmp/
output/report-assets/
# Local Codex diagnostics
.codex-git-diagnostic.*

# Service-account credentials (never commit)
*adminsdk*.json
*service-account*.json
*service_account*.json
firebase-admin*.json
# Local environment files
.env
.env.local
.env.*.local
!.env.example
!mobile-patient/.env.example

# Local diagnostics
.codex-git-diagnostic.*

# Private service-account credentials
*adminsdk*.json
*service-account*.json
*service_account*.json
firebase-admin*.json
# Codex local build and deployment logs
.codex-*.log
.codex-*-exit.txt
# Local diagnostics and release artifacts
.codex-git-diagnostic.*
.release-status.*
.codex-state.*

# Private runtime configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Never commit server/admin credentials
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
service-account*.json
**/service-account*.json
google-service-account*.json
**/google-service-account*.json
# Local Codex diagnostics and generated inspection artifacts
.codex-build-*
.codex-check-*
.codex-config-*
.codex-root-*
.codex-release-*
.codex-status*
.codex-vercel-*
.inspect-*.png
